{
  "type": "object",
  "required": ["id", "book", "member", "borrow_date", "due_date", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^ln_[a-z0-9]+$"},
    "borrow_date": {"type": "string", "format": "date"},
    "due_date": {"type": "string", "format": "date"},
    "return_date": {"type": "string", "format": "date", "nullable": true},
    "status": {
      "enum": ["borrowed", "returned", "overdue", "lost"]
    },
    "book": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"}
      }
    },
    "member": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "full_name": {"type": "string"},
        "email": {"type": "string"}
      }
    }
  }
}